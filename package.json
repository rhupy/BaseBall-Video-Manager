{
  "name": "baseball-video-manager-electron",
  "version": "1.0.0",
  "description": "High-performance video and file manager built with Electron",
  "main": "src/main/electron.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win-portable": "electron-builder --win portable",
    "dist": "electron-builder --publish=never",
    "pack": "electron-builder --dir"
  },
  "keywords": ["electron", "video-manager", "file-manager", "performance"],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "chokidar": "^3.5.3",
    "archiver": "^7.0.1"
  },
  "build": {
    "appId": "com.baseball-video-manager.app",
    "productName": "Baseball Video Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icons/icon.ico",
      "compression": "maximum",
      "extraResources": [
        {
          "from": "data",
          "to": "data",
          "filter": ["**/*"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    }
  }
}